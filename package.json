{
  "name": "ticket-manager-cli",
  "version": "1.0.0",
  "description": "Ticket Manager CLI: create, list, show and update tickets stored in a local JSON file (built with TDD)",
  "main": "src/cli.js",
  "bin": {
    "tickets": "./bin/tickets.js"
  },
  "scripts": {
    "test": "npm run test:tickets && npm run test:kb",
    "test:tickets": "node --test \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:kb": "jest",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "kb-server": "npm run build && node dist/kb/startServer.js",
    "coverage": "node --test --experimental-test-coverage \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\" && jest --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cli",
    "tickets",
    "tdd"
  ],
  "author": "Nguyen Thuy Ngoc",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
